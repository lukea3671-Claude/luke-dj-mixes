---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getMixGradient, isAnalyzed as checkAnalyzed } from '../../utils/mix-gradient';
import MixStats from '../../components/MixStats.tsx';
import WaveformBorder from '../../components/WaveformBorder.tsx';
import LinerNotesIntro from '../../components/LinerNotesIntro.tsx';

export async function getStaticPaths() {
  const mixes = await getCollection('mixes');
  return mixes.map((mix) => ({
    params: { slug: mix.id.replace(/\.md$/, '') },
    props: { mix },
  }));
}

const { mix } = Astro.props;
const { Content } = await mix.render();
const data = mix.data;
const slug = mix.id.replace(/\.md$/, '');
const siteUrl = 'https://mixes.lukeanderson.au';
const mixUrl = `${siteUrl}/mix/${slug}`;
const audioUrl = `${siteUrl}${data.audioFile}`;
const genres = data.genres.slice(0, 3).map((g: { name: string }) => g.name).join(', ');
const desc = data.bpm > 0
  ? `${data.title} — ${data.duration}, ${data.trackCount} tracks. ${genres}. Free streaming with AI-generated liner notes.`
  : `${data.title} — ${data.duration}. Free streaming.`;
const gradient = getMixGradient(data);
const analyzed = checkAnalyzed(data);

// Parse track listing from markdown for interactive tracklist
const rawContent = mix.body || '';
const trackRegex = /\|\s*(\d+)\s*\|\s*([\d:]+)\s*\|\s*([^|]+)\s*\|\s*([^|]+)\s*\|\s*([^|]*)\s*\|/g;
const tracks: Array<{num: number, time: string, seconds: number, artist: string, title: string, genre: string}> = [];
let trackMatch;
while ((trackMatch = trackRegex.exec(rawContent)) !== null) {
  const [, num, time, artist, title, genre] = trackMatch;
  const parts = time.trim().split(':').map(Number);
  const seconds = parts.length === 3 ? parts[0]*3600 + parts[1]*60 + parts[2] : parts[0]*60 + parts[1];
  tracks.push({
    num: Number(num),
    time: time.trim(),
    artist: artist.trim(),
    title: title.trim(),
    genre: genre.trim(),
    seconds,
  });
}

// Extract first paragraph from liner notes for text-generate effect
const bodyText = mix.body || '';
const linerNotesMatch = bodyText.match(/## (?:Luke's Notes|Liner Notes)\s*\n\n(.+?)(?:\n\n|\n##|$)/s);
const firstParagraph = linerNotesMatch?.[1]?.replace(/\*[^*]+\*/g, '')?.trim() || '';

const playerTracks = tracks.map(t => ({
  time: t.time,
  name: t.artist + ' \u2014 ' + t.title,
  seconds: t.seconds,
}));
const tracksJson = JSON.stringify(playerTracks);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['MusicRecording', 'PodcastEpisode'],
  name: data.title,
  description: desc,
  url: mixUrl,
  duration: 'PT' + data.duration.replace(/\s/g, '').replace('h', 'H').replace('m', 'M').replace('s', 'S'),
  genre: data.genres.map((g: { name: string }) => g.name),
  byArtist: { '@type': 'Person', name: 'Luke Anderson' },
  associatedMedia: {
    '@type': 'MediaObject',
    contentUrl: audioUrl,
    encodingFormat: 'audio/mpeg',
    contentSize: data.fileSizeMb + 'MB',
  },
  partOfSeries: {
    '@type': 'PodcastSeries',
    name: "Luke's Mixes",
    url: siteUrl,
  },
  episodeNumber: data.mixNumber,
};
---

<BaseLayout title={data.title} description={desc} ogType="music.song" ogAudio={audioUrl} jsonLd={jsonLd}>
  <article class="mix-page">
    <!-- Cover Art Header -->
    <div class="mix-header">
      <div class="mix-header-gradient" style={`background: ${gradient};`}>
        <div class="mix-header-grain"></div>
        <div class="mix-header-leak"></div>
      </div>
      <div class="mix-header-content">
        <a href="/" class="back-link">&larr; Back to crate</a>
        <h1>{data.title}</h1>
        <p class="mix-date">{data.date}</p>
        <button
          class="play-button"
          data-audio-url={data.audioFile}
          data-title={data.title}
          data-gradient={gradient}
          data-tracks={tracksJson}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          Play Mix
        </button>
      </div>
    </div>

    <!-- Waveform with BorderBeam -->
    <div
      id="waveform"
      class="relative overflow-hidden"
      data-peaks-url={data.peaksFile}
      data-audio-url={data.audioFile}
      data-mix-title={data.title}
      data-mix-gradient={gradient}
      data-tracks={tracksJson}
    >
      <WaveformBorder client:visible />
    </div>

    <!-- Stats with NumberTicker + MagicCard -->
    <MixStats
      client:visible
      duration={data.duration}
      bpm={data.bpm}
      musicalKey={data.musicalKey}
      trackCount={data.trackCount}
      fileSizeMb={data.fileSizeMb}
      isAnalyzed={analyzed}
    />

    <!-- Genre Pills -->
    {analyzed && data.genres.length > 0 && (
      <div class="genre-tags">
        {data.genres.map((g) => (
          <span class="genre-pill">{g.name} <small>({g.percent}%)</small></span>
        ))}
      </div>
    )}

    <!-- Tracklist -->
    {tracks.length > 0 && (
      <section class="tracklist-section">
        <h2>Tracklist</h2>
        <div class="tracklist" id="tracklist">
          {tracks.map((t) => (
            <button
              class="track-row"
              data-seconds={t.seconds}
              aria-label={`Play from ${t.time} — ${t.artist}, ${t.title}`}
            >
              <span class="track-num">{t.num}</span>
              <span class="track-time">{t.time}</span>
              <div class="track-info">
                <span class="track-artist">{t.artist}</span>
                <span class="track-title">{t.title}</span>
              </div>
              <span class="track-genre">{t.genre || ''}</span>
            </button>
          ))}
        </div>
      </section>
    )}

    <!-- Liner Notes Intro (word-by-word reveal) -->
    {firstParagraph && firstParagraph.length > 20 && (
      <LinerNotesIntro client:visible text={firstParagraph} />
    )}

    <!-- Liner Notes -->
    <div class="mix-content">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .mix-page {
    max-width: 900px;
  }

  /* Cover Art Header */
  .mix-header {
    position: relative;
    margin: -2rem -2rem 2rem -2rem;
    padding: 3rem 2rem 2rem;
    overflow: hidden;
  }

  .mix-header-gradient {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    mask-image: linear-gradient(to bottom, black 40%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, black 40%, transparent);
  }

  .mix-header-grain {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 256px;
    pointer-events: none;
  }

  .mix-header-leak {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 80% 20%, rgba(212, 165, 116, 0.06) 0%, transparent 50%);
    pointer-events: none;
  }

  .mix-header-content {
    position: relative;
    z-index: 1;
  }

  .back-link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--muted-stone);
    margin-bottom: 1.5rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: var(--warm-cream);
  }

  .mix-header h1 {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    margin-bottom: 0.25rem;
    color: var(--warm-cream);
  }

  .mix-date {
    color: var(--muted-stone);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .play-button {
    background: var(--amber);
    color: var(--base);
    border: none;
    padding: 0.75rem 2rem;
    border-radius: 8px;
    font-size: 1rem;
    font-family: var(--font-heading);
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .play-button:hover {
    background: var(--warm-cream);
    box-shadow: 0 0 20px var(--amber-glow);
  }

  /* Genre tags */
  .genre-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  /* Waveform */
  #waveform {
    margin: 1.5rem 0;
    padding: 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    cursor: pointer;
    min-height: 96px;
    transition: box-shadow 0.2s;
  }

  #waveform:hover {
    box-shadow: 0 0 12px var(--amber-glow);
  }

  /* Tracklist */
  .tracklist-section {
    margin-bottom: 2.5rem;
  }

  .tracklist-section h2 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--muted-stone);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .tracklist {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .track-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    border: none;
    border-radius: 4px;
    cursor: pointer;
    color: var(--warm-cream);
    text-align: left;
    font-family: var(--font-body);
    font-size: 0.85rem;
    transition: all 0.15s;
    width: 100%;
    border-left: 3px solid transparent;
  }

  .track-row:hover {
    background: var(--surface-hover);
    border-left-color: var(--amber);
  }

  .track-row.active {
    background: rgba(212, 165, 116, 0.08);
    border-left-color: var(--amber);
  }

  .track-row.active .track-artist {
    color: var(--amber);
  }

  .track-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-stone);
    min-width: 24px;
    text-align: right;
    opacity: 0.5;
  }

  .track-time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-stone);
    min-width: 48px;
  }

  .track-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .track-artist {
    font-weight: 600;
    font-size: 0.83rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-title {
    font-size: 0.78rem;
    color: var(--muted-stone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-genre {
    font-size: 0.7rem;
    color: var(--muted-stone);
    opacity: 0.5;
    min-width: 60px;
    text-align: right;
  }

  /* Liner notes / markdown content */
  .mix-content {
    line-height: 1.7;
  }

  .mix-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    color: var(--amber);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .mix-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin: 1rem 0;
  }

  .mix-content :global(th),
  .mix-content :global(td) {
    text-align: left;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .mix-content :global(th) {
    color: var(--muted-stone);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mix-content :global(tr:hover) {
    background: var(--surface-hover);
  }

  .mix-content :global(td:first-child) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted-stone);
    white-space: nowrap;
  }

  .mix-content :global(ul) {
    list-style: none;
    padding: 0;
  }

  .mix-content :global(li) {
    padding: 0.3rem 0;
    border-bottom: 1px solid rgba(42, 36, 32, 0.5);
  }

  .mix-content :global(li:last-child) {
    border-bottom: none;
  }

  .mix-content :global(strong) {
    color: var(--warm-cream);
    font-weight: 600;
  }

  .mix-content :global(em) {
    color: var(--muted-stone);
    font-style: italic;
  }

  .mix-content :global(p) {
    margin-bottom: 1rem;
    color: var(--muted-stone);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .mix-header {
      margin: -1rem -1rem 1.5rem -1rem;
      padding: 2rem 1rem 1.5rem;
    }

    .mix-header h1 {
      font-size: 1.6rem;
    }

    .track-genre {
      display: none;
    }

    .track-row {
      padding: 0.5rem 0.5rem;
      gap: 0.5rem;
    }

    .mix-content :global(table) {
      font-size: 0.75rem;
    }

    .mix-content :global(th),
    .mix-content :global(td) {
      padding: 0.4rem 0.5rem;
    }

    #waveform {
      padding: 0.5rem;
      min-height: 72px;
    }
  }
</style>

<script>
  import WaveSurfer from 'wavesurfer.js';

  let ws: WaveSurfer | null = null;
  let syncHandler: (() => void) | null = null;

  function initWaveform() {
    const container = document.getElementById('waveform');
    if (!container) return;

    if (ws) {
      ws.destroy();
      ws = null;
    }
    if (syncHandler) {
      const audio = document.getElementById('audio-element') as HTMLAudioElement;
      if (audio) audio.removeEventListener('timeupdate', syncHandler);
      syncHandler = null;
    }

    const peaksUrl = container.dataset.peaksUrl;
    const audioUrl = container.dataset.audioUrl;
    const mixTitle = container.dataset.mixTitle;
    const mixGradient = container.dataset.mixGradient;
    const tracksData = container.dataset.tracks;
    const audio = document.getElementById('audio-element') as HTMLAudioElement;

    if (!peaksUrl || !audio) return;

    fetch(peaksUrl)
      .then(r => r.json())
      .then(peaksData => {
        const raw: number[] = peaksData.data;
        const peaks: number[] = [];
        for (let i = 0; i < raw.length; i += 2) {
          peaks.push(Math.max(Math.abs(raw[i]), Math.abs(raw[i + 1])) / 128);
        }

        const duration = peaksData.length * peaksData.samples_per_pixel / peaksData.sample_rate;

        ws = WaveSurfer.create({
          container: '#waveform',
          peaks: [peaks],
          duration: duration,
          height: 80,
          waveColor: '#2A2420',
          progressColor: '#D4A574',
          cursorColor: '#F5E6C8',
          cursorWidth: 2,
          barWidth: 2,
          barGap: 1,
          barRadius: 2,
          normalize: true,
          interact: true,
        });

        let isSeeking = false;

        syncHandler = () => {
          if (isSeeking || !ws) return;
          if (audio.src && audio.duration && audio.src.includes(audioUrl!)) {
            ws.seekTo(audio.currentTime / audio.duration);
          }
        };
        audio.addEventListener('timeupdate', syncHandler);

        let parsedTracks: Array<{time: string, name: string, seconds: number}> = [];
        if (tracksData) {
          try { parsedTracks = JSON.parse(tracksData); } catch {}
        }

        ws.on('interaction', (time: number) => {
          isSeeking = true;
          if (!audio.src || !audio.src.includes(audioUrl!)) {
            (window as any).loadMix(audioUrl, mixTitle, mixGradient, parsedTracks);
            audio.addEventListener('loadedmetadata', () => {
              audio.currentTime = time;
              isSeeking = false;
            }, { once: true });
          } else {
            audio.currentTime = time;
            if (audio.paused) audio.play();
            setTimeout(() => { isSeeking = false; }, 100);
          }
        });
      })
      .catch(err => console.warn('Failed to load peaks:', err));
  }

  function initTracklist() {
    const tracklist = document.getElementById('tracklist');
    const container = document.getElementById('waveform');
    if (!tracklist || !container) return;

    const audioUrl = container.dataset.audioUrl;
    const mixTitle = container.dataset.mixTitle;
    const mixGradient = container.dataset.mixGradient;
    const tracksData = container.dataset.tracks;
    let parsedTracks: Array<{time: string, name: string, seconds: number}> = [];
    if (tracksData) {
      try { parsedTracks = JSON.parse(tracksData); } catch {}
    }

    tracklist.addEventListener('click', (e) => {
      const row = (e.target as Element).closest('.track-row') as HTMLElement;
      if (!row) return;

      const seconds = Number(row.dataset.seconds);
      const audio = document.getElementById('audio-element') as HTMLAudioElement;
      if (!audio) return;

      if (!audio.src || !audio.src.includes(audioUrl!)) {
        (window as any).loadMix(audioUrl, mixTitle, mixGradient, parsedTracks);
        audio.addEventListener('loadedmetadata', () => {
          audio.currentTime = seconds;
        }, { once: true });
      } else {
        audio.currentTime = seconds;
        if (audio.paused) audio.play();
      }
    });

    const audio = document.getElementById('audio-element') as HTMLAudioElement;
    if (audio && audioUrl) {
      audio.addEventListener('timeupdate', () => {
        if (!audio.src || !audio.src.includes(audioUrl)) return;

        const rows = tracklist.querySelectorAll('.track-row');
        let activeRow: Element | null = null;

        rows.forEach(row => {
          const seconds = Number((row as HTMLElement).dataset.seconds);
          row.classList.remove('active');
          if (seconds <= audio.currentTime) activeRow = row;
        });

        if (activeRow) {
          (activeRow as Element).classList.add('active');
        }
      });
    }
  }

  function initPlayButton() {
    const btn = document.querySelector('.play-button') as HTMLButtonElement;
    if (!btn) return;

    btn.addEventListener('click', () => {
      const audioUrl = btn.dataset.audioUrl;
      const title = btn.dataset.title;
      const gradient = btn.dataset.gradient;
      let tracks: any[] = [];
      try { tracks = JSON.parse(btn.dataset.tracks || '[]'); } catch {}
      if (audioUrl && title) {
        (window as any).loadMix(audioUrl, title, gradient, tracks);
      }
    });
  }

  initWaveform();
  initTracklist();
  initPlayButton();
  document.addEventListener('astro:after-swap', () => {
    initWaveform();
    initTracklist();
    initPlayButton();
  });
</script>
