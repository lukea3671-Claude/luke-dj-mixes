---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import FilmGrain from '../components/FilmGrain.astro';
import AmbientParticles from '../components/AmbientParticles.tsx';
import ShootingStars from '../components/ShootingStars.tsx';
import SolarSystem from '../components/SolarSystem.tsx';
import TopScrollProgress from '../components/TopScrollProgress.tsx';

interface Props {
  title: string;
  description?: string;
  ogType?: string;
  ogAudio?: string;
  ogImage?: string;
  jsonLd?: object;
}

const {
  title,
  description = "Luke's DJ mix archive — free streaming with AI-generated liner notes",
  ogType = 'website',
  ogAudio,
  ogImage,
  jsonLd,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, 'https://luke-dj-mixes.pages.dev').href;
// Absolute URL for social cards; mix pages pass their cover art.
const ogImageUrl = new URL(ogImage ?? '/icon-512.png', 'https://luke-dj-mixes.pages.dev').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0A0A0A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Luke's Mixes Podcast" href="/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Luke's Mixes" />
    <meta property="og:image" content={ogImageUrl} />
    {ogAudio && <meta property="og:audio" content={ogAudio} />}
    {ogAudio && <meta property="og:audio:type" content="audio/mpeg" />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ViewTransitions />
  </head>
  <body>
    <SolarSystem client:idle />
    <AmbientParticles client:idle />
    <ShootingStars client:idle />
    <TopScrollProgress client:idle />
    <header class="border-b border-[--border] py-4 px-8 bg-[var(--surface)] max-sm:px-4 max-sm:py-3 relative z-[1]">
      <nav class="flex justify-between items-center max-w-[1200px] mx-auto">
        <a href="/" class="font-heading text-2xl font-bold text-[--amber] tracking-[-0.02em] transition-[text-shadow,color] duration-200 hover:text-[--warm-cream] hover:[text-shadow:0_0_12px_var(--amber-glow)]">Luke's Mixes</a>
        <div class="flex gap-6 max-sm:gap-4">
          <a href="/collection" class="nav-link">Collection</a>
          <a href="/#archive" class="nav-link">Archive</a>
          <a href="/about" class="nav-link">About</a>
        </div>
      </nav>
    </header>

    <div class="relative z-[1]">
    <slot name="hero" />
    <main>
      <slot />
    </main>

    <div id="player-bar" transition:persist>
      <!-- Expanded vinyl panel -->
      <div class="player-expanded" id="player-expanded">
        <div class="expanded-inner">
          <div class="expanded-vinyl-area">
            <div class="vinyl-disc large" id="vinyl-large">
              <div class="vinyl-grooves"></div>
              <div class="vinyl-label" id="vinyl-label-large"></div>
              <div class="vinyl-reflection"></div>
            </div>
            <div class="tonearm" id="tonearm" style="--progress: 0"></div>
          </div>
          <div class="expanded-info">
            <div class="expanded-meta">
              <span class="expanded-now-playing">Now Playing</span>
              <span class="expanded-title" id="expanded-title"></span>
              <span class="expanded-track" id="expanded-track"></span>
            </div>
            <button class="expand-toggle" id="player-collapse" aria-label="Collapse player">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
        </div>
      </div>
      <!-- Compact bar -->
      <div class="player-inner">
        <div class="player-info">
          <div class="vinyl-disc mini" id="vinyl-mini" role="button" tabindex="0" aria-label="Expand player">
            <div class="vinyl-grooves"></div>
            <div class="vinyl-label" id="vinyl-label-mini"></div>
            <div class="vinyl-reflection"></div>
          </div>
          <div class="player-text">
            <span id="player-title">No mix loaded</span>
            <span id="player-track" class="player-track-name"></span>
          </div>
        </div>
        <div class="player-controls">
          <button id="player-prev" aria-label="Seek back 30 seconds" disabled>&laquo;</button>
          <button id="player-play" aria-label="Play" disabled>
            <span class="play-icon">&#9654;</span>
            <span class="pause-icon" style="display:none">&#10074;&#10074;</span>
          </button>
          <button id="player-next" aria-label="Seek forward 30 seconds" disabled>&raquo;</button>
        </div>
        <div class="player-time">
          <span id="player-current">0:00</span>
          <input type="range" id="player-seek" min="0" max="100" value="0" step="0.1" disabled aria-label="Seek position" />
          <span id="player-duration">0:00</span>
        </div>
        <div class="player-extras">
          <div class="volume-control">
            <button id="player-mute" aria-label="Mute">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
            </button>
            <input type="range" id="player-volume" min="0" max="100" value="100" aria-label="Volume" />
          </div>
          <button id="player-cast" aria-label="Cast to device" title="Cast to device" style="display:none">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M1 18v3h3c0-1.66-1.34-3-3-3zm0-4v2c2.76 0 5 2.24 5 5h2c0-3.87-3.13-7-7-7zm18-7H5v1.63c3.96 1.28 7.09 4.41 8.37 8.37H19V7zM1 10v2c4.97 0 9 4.03 9 9h2c0-6.08-4.93-11-11-11zm20-7H3c-1.1 0-2 .9-2 2v3h2V5h18v14h-7v2h7c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
            </svg>
          </button>
        </div>
      </div>
      <audio id="audio-element" preload="none"></audio>
    </div>

    <div id="now-playing-announce" aria-live="polite" class="sr-only"></div>

    </div>
    <footer class="text-center py-8 px-4 text-[--muted-stone] text-[0.85rem] border-t border-[--border] relative z-[1]">
      <p>Free streaming. No account needed. <a href="https://www.patreon.com/c/lukesmixes" target="_blank" rel="noopener" class="text-[--amber] hover:text-[--warm-cream] transition-colors">Support on Patreon</a></p>
    </footer>
  </body>
</html>

<style is:global>
  /* Nav link underline effect */
  .nav-link {
    color: var(--muted-stone);
    font-size: 0.9rem;
    font-weight: 500;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--amber);
    transition: width 0.2s;
  }

  .nav-link:hover {
    color: var(--warm-cream);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
  }

  /* Player bar */
  #player-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border-top: 1px solid var(--glass-border);
    z-index: 100;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  #player-bar.active {
    border-top-color: rgba(212, 165, 116, 0.3);
    box-shadow: 0 -2px 20px rgba(212, 165, 116, 0.08);
  }

  .player-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    height: var(--player-height);
    padding: 0 1.5rem;
  }

  .player-info {
    flex: 0 0 220px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    overflow: hidden;
  }

  /* ── Vinyl Disc ── */
  .vinyl-disc {
    border-radius: 50%;
    position: relative;
    background: #111;
    flex-shrink: 0;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.06),
      0 2px 12px rgba(0,0,0,0.5);
  }

  .vinyl-disc.mini {
    width: 48px;
    height: 48px;
    cursor: pointer;
    transition: box-shadow 0.3s;
  }

  .vinyl-disc.mini:hover {
    box-shadow:
      0 0 0 1px rgba(212,165,116,0.3),
      0 0 16px rgba(212,165,116,0.15);
  }

  .vinyl-disc.large {
    width: 160px;
    height: 160px;
  }

  .vinyl-disc.spinning {
    animation: vinyl-spin 1.8s linear infinite;
  }

  .vinyl-disc:not(.spinning) {
    animation: vinyl-spin 1.8s linear infinite paused;
  }

  .vinyl-grooves {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      repeating-radial-gradient(
        circle at center,
        transparent 0px,
        transparent 2px,
        rgba(255,255,255,0.035) 2.5px,
        transparent 3px
      );
  }

  .vinyl-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--surface);
    transition: background 0.3s;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.08),
      inset 0 1px 2px rgba(0,0,0,0.3);
  }

  .vinyl-disc.mini .vinyl-label {
    width: 20px;
    height: 20px;
  }

  .vinyl-disc.large .vinyl-label {
    width: 56px;
    height: 56px;
  }

  /* Center spindle hole */
  .vinyl-label::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #0A0A0A;
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.08);
  }

  .vinyl-disc.mini .vinyl-label::after {
    width: 5px;
    height: 5px;
  }

  .vinyl-disc.large .vinyl-label::after {
    width: 10px;
    height: 10px;
  }

  /* Light reflection sweep */
  .vinyl-reflection {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(
      135deg,
      rgba(255,255,255,0.1) 0%,
      transparent 35%,
      transparent 65%,
      rgba(255,255,255,0.04) 100%
    );
    pointer-events: none;
  }

  @keyframes vinyl-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ── Expanded Panel ── */
  .player-expanded {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.2, 0, 0.2, 1),
                padding 0.5s cubic-bezier(0.2, 0, 0.2, 1);
    padding: 0 1.5rem;
  }

  .player-expanded.open {
    max-height: 260px;
    padding: 1.5rem;
    border-bottom: 1px solid var(--glass-border);
  }

  .expanded-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .expanded-vinyl-area {
    position: relative;
    width: 200px;
    height: 170px;
    flex-shrink: 0;
  }

  .expanded-vinyl-area .vinyl-disc.large {
    position: absolute;
    bottom: 0;
    left: 0;
  }

  /* ── Tonearm ── */
  .tonearm {
    position: absolute;
    top: 0;
    right: 15px;
    width: 3px;
    height: 100px;
    background: linear-gradient(to bottom, #9a8e82 0%, #7a6e62 60%, #6a5e52 100%);
    border-radius: 1.5px;
    transform-origin: center 6px;
    transform: rotate(calc(16deg + var(--progress, 0) * 22deg));
    transition: transform 1s ease-out;
  }

  /* Pivot base */
  .tonearm::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #5a5048, #3a3430);
    border: 1px solid rgba(255,255,255,0.08);
  }

  /* Cartridge/head */
  .tonearm::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    width: 7px;
    height: 10px;
    background: linear-gradient(to bottom, #D4A574, #b8926a);
    border-radius: 1px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.6), 0 0 4px rgba(212,165,116,0.3);
  }

  .expanded-info {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }

  .expanded-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .expanded-now-playing {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--amber);
    opacity: 0.8;
  }

  .expanded-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--warm-cream);
    letter-spacing: -0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .expanded-track {
    font-size: 0.85rem;
    color: var(--muted-stone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .expand-toggle {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted-stone);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .expand-toggle:hover {
    border-color: var(--amber);
    color: var(--amber);
  }

  .player-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: 0.1rem;
  }

  #player-title {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    color: var(--muted-stone);
    transition: color 0.2s;
  }

  #player-title.active {
    color: var(--warm-cream);
  }

  .player-track-name {
    font-size: 0.72rem;
    color: var(--muted-stone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block;
    opacity: 0.7;
    min-height: 1em;
  }

  .player-controls {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-shrink: 0;
  }

  .player-controls button {
    background: none;
    border: 1px solid var(--border);
    color: var(--muted-stone);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }

  .player-controls button:hover:not(:disabled) {
    border-color: var(--amber);
    color: var(--amber);
    box-shadow: 0 0 8px var(--amber-glow);
  }

  .player-controls button:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  #player-play {
    width: 42px;
    height: 42px;
    font-size: 1rem;
    color: var(--warm-cream);
    border-color: var(--muted-stone);
  }

  #player-play:hover:not(:disabled) {
    border-color: var(--amber);
    color: var(--amber);
    box-shadow: 0 0 12px var(--amber-glow);
  }

  .player-time {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--muted-stone);
  }

  #player-seek {
    flex: 1;
    accent-color: var(--amber);
    height: 4px;
    cursor: pointer;
  }

  .player-extras {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .volume-control {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .volume-control button {
    background: none;
    border: none;
    color: var(--muted-stone);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }

  .volume-control button:hover {
    color: var(--amber);
  }

  #player-volume {
    width: 80px;
    accent-color: var(--amber);
    height: 3px;
    cursor: pointer;
  }

  #player-cast {
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--border);
    color: var(--muted-stone);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }

  #player-cast:hover {
    border-color: var(--amber);
    color: var(--amber);
    box-shadow: 0 0 8px var(--amber-glow);
  }

  #player-cast.connecting {
    animation: cast-pulse 1.5s ease-in-out infinite;
  }

  #player-cast.connected {
    border-color: var(--amber);
    color: var(--amber);
    background: rgba(212, 165, 116, 0.1);
  }

  @keyframes cast-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  @media (max-width: 768px) {
    main {
      padding: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    main {
      padding: 1rem;
    }

    #player-bar {
      height: var(--player-height-mobile);
      padding: 0 0.75rem;
    }

    body {
      padding-bottom: calc(var(--player-height-mobile) + 8px);
    }

    .player-info {
      flex: 0 0 auto;
      max-width: 140px;
    }

    .vinyl-disc.mini {
      width: 38px;
      height: 38px;
    }

    .vinyl-disc.mini .vinyl-label {
      width: 16px;
      height: 16px;
    }

    .player-expanded {
      display: none;
    }

    .player-track-name {
      display: none;
    }

    .player-inner {
      gap: 0.5rem;
    }

    #player-play {
      width: 38px;
      height: 38px;
    }

    .player-controls button {
      width: 30px;
      height: 30px;
    }

    .volume-control {
      display: none;
    }

    .player-time {
      gap: 0.4rem;
      font-size: 0.7rem;
    }
  }
</style>

<script>
  function initPlayer() {
    const audio = document.getElementById('audio-element') as HTMLAudioElement;
    const playBtn = document.getElementById('player-play') as HTMLButtonElement;
    const prevBtn = document.getElementById('player-prev') as HTMLButtonElement;
    const nextBtn = document.getElementById('player-next') as HTMLButtonElement;
    const seekBar = document.getElementById('player-seek') as HTMLInputElement;
    const titleEl = document.getElementById('player-title') as HTMLSpanElement;
    const trackEl = document.getElementById('player-track') as HTMLSpanElement;
    const currentEl = document.getElementById('player-current') as HTMLSpanElement;
    const durationEl = document.getElementById('player-duration') as HTMLSpanElement;
    const volumeSlider = document.getElementById('player-volume') as HTMLInputElement;
    const muteBtn = document.getElementById('player-mute') as HTMLButtonElement;
    const playIcon = playBtn?.querySelector('.play-icon') as HTMLElement;
    const pauseIcon = playBtn?.querySelector('.pause-icon') as HTMLElement;
    const announce = document.getElementById('now-playing-announce');

    // Vinyl elements
    const vinylMini = document.getElementById('vinyl-mini');
    const vinylLarge = document.getElementById('vinyl-large');
    const vinylLabelMini = document.getElementById('vinyl-label-mini');
    const vinylLabelLarge = document.getElementById('vinyl-label-large');
    const tonearm = document.getElementById('tonearm');
    const expandedPanel = document.getElementById('player-expanded');
    const collapseBtn = document.getElementById('player-collapse');
    const expandedTitle = document.getElementById('expanded-title');
    const expandedTrack = document.getElementById('expanded-track');

    if (!audio || !playBtn) return;

    // Guard against duplicate listeners on persisted elements (Astro View Transitions)
    if ((audio as any).__playerInit) return;
    (audio as any).__playerInit = true;

    function formatTime(s: number): string {
      if (isNaN(s)) return '0:00';
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      const sec = Math.floor(s % 60);
      if (h > 0) return `${h}:${m.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
      return `${m}:${sec.toString().padStart(2, '0')}`;
    }

    // Vinyl spin control
    function setVinylSpin(spinning: boolean) {
      [vinylMini, vinylLarge].forEach(v => {
        if (!v) return;
        if (spinning) {
          v.classList.add('spinning');
        } else {
          v.classList.remove('spinning');
        }
      });
    }

    // Expand/collapse
    function toggleExpanded(open?: boolean) {
      if (!expandedPanel) return;
      const isOpen = open !== undefined ? open : !expandedPanel.classList.contains('open');
      expandedPanel.classList.toggle('open', isOpen);
      try { sessionStorage.setItem('player-expanded', String(isOpen)); } catch {}
    }

    // Restore expanded state
    try {
      if (sessionStorage.getItem('player-expanded') === 'true' && audio.src) {
        expandedPanel?.classList.add('open');
      }
    } catch {}

    // Click mini vinyl to expand
    vinylMini?.addEventListener('click', () => {
      if (!audio.src) return;
      toggleExpanded();
    });
    vinylMini?.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' && audio.src) toggleExpanded();
    });

    // Collapse button
    collapseBtn?.addEventListener('click', () => toggleExpanded(false));

    function showPlayState(playing: boolean) {
      if (playIcon) playIcon.style.display = playing ? 'none' : '';
      if (pauseIcon) pauseIcon.style.display = playing ? '' : 'none';
      playBtn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      setVinylSpin(playing);
    }

    playBtn.addEventListener('click', () => {
      audio.paused ? audio.play() : audio.pause();
    });

    prevBtn.addEventListener('click', () => {
      audio.currentTime = Math.max(0, audio.currentTime - 30);
    });

    nextBtn.addEventListener('click', () => {
      audio.currentTime = Math.min(audio.duration, audio.currentTime + 30);
    });

    audio.addEventListener('play', () => showPlayState(true));
    audio.addEventListener('pause', () => showPlayState(false));

    audio.addEventListener('timeupdate', () => {
      currentEl.textContent = formatTime(audio.currentTime);
      if (audio.duration) {
        const progress = audio.currentTime / audio.duration;
        seekBar.value = String(progress * 100);

        // Tonearm follows playback progress
        if (tonearm) {
          tonearm.style.setProperty('--progress', String(progress));
        }
      }

      // Current track detection
      const tracks: Array<{seconds: number, name: string}> = (window as any).__mixTracks || [];
      if (tracks.length > 0) {
        let currentTrack = tracks[0];
        for (const t of tracks) {
          if (t.seconds <= audio.currentTime) currentTrack = t;
          else break;
        }
        if (currentTrack) {
          if (trackEl && trackEl.textContent !== currentTrack.name) {
            trackEl.textContent = currentTrack.name;
          }
          if (expandedTrack && expandedTrack.textContent !== currentTrack.name) {
            expandedTrack.textContent = currentTrack.name;
          }
        }
      }
    });

    audio.addEventListener('loadedmetadata', () => {
      durationEl.textContent = formatTime(audio.duration);
      seekBar.disabled = false;
    });

    seekBar.addEventListener('input', () => {
      if (audio.duration) {
        audio.currentTime = (Number(seekBar.value) / 100) * audio.duration;
      }
    });

    // Volume
    if (volumeSlider) {
      volumeSlider.addEventListener('input', () => {
        audio.volume = Number(volumeSlider.value) / 100;
      });
      audio.addEventListener('volumechange', () => {
        volumeSlider.value = String(Math.round(audio.volume * 100));
      });
    }

    if (muteBtn) {
      muteBtn.addEventListener('click', () => {
        audio.muted = !audio.muted;
        muteBtn.style.opacity = audio.muted ? '0.35' : '1';
      });
    }

    // Media Session API
    if ('mediaSession' in navigator) {
      navigator.mediaSession.setActionHandler('play', () => audio.play());
      navigator.mediaSession.setActionHandler('pause', () => audio.pause());
      navigator.mediaSession.setActionHandler('seekbackward', () => {
        audio.currentTime = Math.max(0, audio.currentTime - 30);
      });
      navigator.mediaSession.setActionHandler('seekforward', () => {
        audio.currentTime = Math.min(audio.duration, audio.currentTime + 30);
      });
    }

    // Remote Playback API
    const castBtn = document.getElementById('player-cast') as HTMLButtonElement;
    if (castBtn && 'remote' in audio) {
      const remote = (audio as any).remote;

      remote.watchAvailability((available: boolean) => {
        castBtn.style.display = available ? 'flex' : 'none';
      }).catch(() => {
        castBtn.style.display = 'flex';
      });

      remote.addEventListener('connecting', () => {
        castBtn.classList.add('connecting');
        castBtn.classList.remove('connected');
      });
      remote.addEventListener('connect', () => {
        castBtn.classList.remove('connecting');
        castBtn.classList.add('connected');
      });
      remote.addEventListener('disconnect', () => {
        castBtn.classList.remove('connecting', 'connected');
      });

      castBtn.addEventListener('click', async () => {
        try {
          await remote.prompt();
        } catch (err: any) {
          if (err.name !== 'NotAllowedError' && err.name !== 'AbortError') {
            console.error('Remote playback error:', err);
          }
        }
      });
    }

    // Global loadMix
    (window as any).loadMix = function(url: string, title: string, gradient?: string, tracks?: Array<{time: string, name: string, seconds: number}>, cover?: string) {
      audio.src = url;
      audio.play();
      titleEl.textContent = title;
      titleEl.classList.add('active');
      document.getElementById('player-bar')?.classList.add('active');
      playBtn.disabled = false;
      prevBtn.disabled = false;
      nextBtn.disabled = false;

      (window as any).__mixTracks = tracks || [];

      // Update vinyl labels with mix gradient
      [vinylLabelMini, vinylLabelLarge].forEach(label => {
        if (label && gradient) label.style.background = gradient;
      });

      // Update expanded panel info
      if (expandedTitle) expandedTitle.textContent = title;
      if (expandedTrack) expandedTrack.textContent = '';

      if (trackEl) trackEl.textContent = '';
      if (announce) announce.textContent = 'Now playing: ' + title;

      // Reset tonearm
      if (tonearm) tonearm.style.setProperty('--progress', '0');

      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: title,
          artist: 'Luke Allan',
          album: "Luke's Mixes",
          // Lock-screen artwork: the playing mix's actual cover,
          // falling back to the app icons.
          artwork: cover
            ? [{ src: cover, sizes: '1200x1200', type: 'image/png' }]
            : [
                { src: '/icon-192.png', sizes: '192x192', type: 'image/png' },
                { src: '/icon-512.png', sizes: '512x512', type: 'image/png' },
              ],
        });
      }
    };

    // Keyboard shortcuts
    function handleKeyboard(e: KeyboardEvent) {
      if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
      if (!audio.src) return;

      switch (e.key) {
        case ' ':
          e.preventDefault();
          audio.paused ? audio.play() : audio.pause();
          break;
        case 'ArrowLeft':
          audio.currentTime = Math.max(0, audio.currentTime - 10);
          break;
        case 'ArrowRight':
          audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 10);
          break;
        case 'ArrowUp':
          e.preventDefault();
          audio.volume = Math.min(1, audio.volume + 0.1);
          break;
        case 'ArrowDown':
          e.preventDefault();
          audio.volume = Math.max(0, audio.volume - 0.1);
          break;
        case 'm':
        case 'M':
          audio.muted = !audio.muted;
          if (muteBtn) muteBtn.style.opacity = audio.muted ? '0.35' : '1';
          break;
      }
    }
    document.addEventListener('keydown', handleKeyboard);
  }

  initPlayer();
  document.addEventListener('astro:after-swap', initPlayer);

  // Register service worker for PWA install
  if ('serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js');
  }
</script>
