# --- npm supply-chain policy (IRI-494 item 3) ---
# Refuse any package version published less than 7 days ago, direct or
# transitive. Malicious npm releases are typically detected and pulled within
# hours to a couple of days, so a cooldown means we are never the early
# adopter of a poisoned publish. This is the control for the finding that
# opened IRI-494: cacheable-request sat 5 patch releases below the poisoned
# 13.0.20, and a routine `npm update` would have crossed into it.
#
# REQUIRES npm >= 11.19.0. Older npm IGNORES this key -- it prints
# "Unknown project config" and installs anyway (verified on 11.6.2 and 11.9.0,
# 2026-08-21). npm-audit-sweep.py checks this nightly so it cannot rot silently.
#
# Urgent legitimate fix inside the window:  npm install <pkg> --min-release-age=0
min-release-age=7
# New direct deps are written as exact versions rather than ^ranges, so future
# installs do not reintroduce drift. Does not rewrite existing ranges.
save-exact=true
